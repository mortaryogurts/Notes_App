<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TodoApp" parent="Theme.Material3.Light.NoActionBar">
        <!-- Main Colors -->
        <item name="colorPrimary">@color/primary_brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/text_secondary</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">#AAB3BB</item>

        <!-- Material 3 Card & Surface Colors -->
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/card_bg</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="colorContainer">@color/card_bg</item>
        <item name="colorOnContainer">@color/text_primary</item>

        <!-- FAB & Container Colors -->
        <item name="colorPrimaryContainer">@color/primary_brand</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
    </style>

    <style name="Theme.TodoApp" parent="Base.Theme.TodoApp" />
</resources>
